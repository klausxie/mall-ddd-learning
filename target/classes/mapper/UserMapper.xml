<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  用户持久化。列名与 resources/schema.sql 的 `user` 表一一对应；
  显式写 resultMap，不依赖 map-underscore-to-camel-case 这类全局开关。
-->
<mapper namespace="cn.mklaus.app.domain.user.UserMapper">

    <resultMap id="userResult" type="cn.mklaus.app.domain.user.User">
        <id property="id" column="id"/>
        <result property="mobile" column="mobile"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="avatar" column="avatar"/>
        <result property="age" column="age"/>
    </resultMap>

    <sql id="userColumns">
        id, mobile, password, nickname, avatar, age
    </sql>

    <select id="getUser" resultMap="userResult">
        SELECT
        <include refid="userColumns"/>
        FROM `user`
        WHERE id = #{id}
    </select>

    <select id="getUserByMobile" resultMap="userResult">
        SELECT
        <include refid="userColumns"/>
        FROM `user`
        WHERE mobile = #{mobile}
    </select>

    <insert id="saveUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user` (mobile, password, nickname, avatar, age)
        VALUES (#{mobile}, #{password}, #{nickname}, #{avatar}, #{age})
    </insert>

    <update id="updateUser">
        UPDATE `user`
        SET mobile   = #{mobile},
            password = #{password},
            nickname = #{nickname},
            avatar   = #{avatar},
            age      = #{age}
        WHERE id = #{id}
    </update>

</mapper>
