# 复制为 application-local.yaml 后填写真实凭证；该文件已在 .gitignore 里，不会被提交。
#
# ⚠️ 只把它指向**本地或你专属的**库：
#   - Spring 启动时 Flyway 会在这个库上建表 / 执行迁移，而迁移**不在** @Transactional 的回滚范围内；
#   - 真库测试跑完会回滚数据，但建表与迁移是实打实的。
#   指向共享库或线上库，等于让 `./mvnw verify` 去改那份 schema。
#
# 没有本地库时不必强求：默认的 `./mvnw verify` 不需要数据库，覆盖格式化 + Checkstyle + ArchUnit + 单测；
# 只有 `-Pcoverage-check`（覆盖率门槛 + 真库端到端）才必须有库。
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/mall?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true
    # 与 docker-compose.yml 里创建的账号一致；连自己的库时改成你自己的账号
    username: klaus
    password: '<你的密码>'

app:
  captcha:
    # 本地固定验证码，便于直接 curl 注册
    fixed-code: 123456

# 填了本文件（或用 APP_DB_* 环境变量）就走你这份库——真库测试置备的第一级：
#   ./mvnw clean verify -Pcoverage-check -Dspring.profiles.active=local
# 什么都不配时，测试会自动起一个 mysql:8.0 容器；本机没有 Docker 则降级到 H2 快速通道。
